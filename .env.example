# Kopiere diese Datei nach .env.local und trage die Werte aus deinem
# Supabase-Projekt ein (Project Settings -> API). Beide Variablen sind
# Pflicht, sonst wirft getSupabaseConfig() beim Start.
#
# Der anon key ist oeffentlich (er landet im Client-Bundle) und wird durch
# Row Level Security abgesichert -- der service_role key gehoert NICHT hierhin
# und wird von der App auch nirgends gelesen.

NEXT_PUBLIC_SUPABASE_URL=https://dein-projekt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=dein-anon-key
